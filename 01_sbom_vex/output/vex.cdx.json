        }
      ],
      "analysis": {
        "state": "not_affected",
        "justification": "requires_configuration",
        "detail": "Vulnerability requires SMP (CONFIG_MP_MAX_NUM_CPUS > 1) and CONFIG_USERSPACE. The hello_world sample on qemu_x86 is built without SMP support (single CPU) and without userspace. The vulnerable code path in z_timer_expiration_handler() is only reachable on SMP systems. Source: Zephyr advisory GHSA-gm6w-pv43-m3vf, affected versions >= 2.2.0, <= 4.4.2, fixed in 4.5.0.",
        "responses": ["workaround_available"]
      },
